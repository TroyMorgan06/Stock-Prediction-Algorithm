[Unit]
Description=stock_ai Swing Growth morning paper trade (decide + brackets once)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/stock_ai
EnvironmentFile=/etc/stock-ai/stock-ai.env
# Swing Growth: up to 8 names, ~70% equity deploy, TP +5% / SL -2.5%, SPY uptrend filter.
ExecStart=/opt/stock_ai/.venv/bin/python /opt/stock_ai/hybrid_morning.py --paper --daily-budget 7000 --max-buys 8 --take-profit 0.05 --stop-loss 0.025 --clear-stale-orders
