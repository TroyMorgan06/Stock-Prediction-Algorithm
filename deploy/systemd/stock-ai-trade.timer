[Unit]
Description=Run stock_ai hybrid morning trade once at US open (weekdays)

[Timer]
# Once per weekday shortly after the cash open (America/New_York).
# Set server TZ: sudo timedatectl set-timezone America/New_York
OnCalendar=Mon..Fri 09:35
Persistent=true
Unit=stock-ai-trade.service

[Install]
WantedBy=timers.target
