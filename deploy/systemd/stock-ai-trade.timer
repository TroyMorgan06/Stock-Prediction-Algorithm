[Unit]
Description=Run stock_ai Alpaca executor during US market hours (weekdays)

[Timer]
# Every 30 minutes from open through mid-afternoon (America/New_York).
# Set server TZ: sudo timedatectl set-timezone America/New_York
OnCalendar=Mon..Fri 09:35
OnCalendar=Mon..Fri 10:05
OnCalendar=Mon..Fri 10:35
OnCalendar=Mon..Fri 11:05
OnCalendar=Mon..Fri 11:35
OnCalendar=Mon..Fri 12:05
OnCalendar=Mon..Fri 12:35
OnCalendar=Mon..Fri 13:05
OnCalendar=Mon..Fri 13:35
OnCalendar=Mon..Fri 14:05
OnCalendar=Mon..Fri 14:35
OnCalendar=Mon..Fri 15:05
OnCalendar=Mon..Fri 15:35
Persistent=true
Unit=stock-ai-trade.service

[Install]
WantedBy=timers.target
