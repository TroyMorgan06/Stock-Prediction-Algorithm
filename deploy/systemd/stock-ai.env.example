# Copy to: /etc/stock-ai/stock-ai.env
# Then: sudo chmod 600 /etc/stock-ai/stock-ai.env

# Alpaca credentials (must match paper vs live — see UBUNTU_SYSTEMD_SETUP.md)
# Paper account with --paper: use keys from Alpaca → Paper Trading → API Keys.
# Live account: use Live keys and remove --paper from stock-ai-trade.service.
APCA_API_KEY_ID=YOUR_PAPER_OR_LIVE_KEY_ID
APCA_API_SECRET_KEY=YOUR_PAPER_OR_LIVE_SECRET

# Optional: OpenAI-compatible key for hybrid_decide LLM basket selection.
# If unset, morning job uses rule-based picks (still fully auto).
# OPENAI_API_KEY=sk-...
# HYBRID_LLM_API_KEY=sk-...
# HYBRID_LLM_BASE_URL=https://api.openai.com/v1
# HYBRID_LLM_MODEL=gpt-4o-mini
